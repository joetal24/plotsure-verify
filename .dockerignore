# ============================================
# Docker Ignore — PlotSure Backend
# ============================================

# Git
.git
.gitignore

# Secrets (NEVER ship these into the image)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv
venv/

# Tests (not needed at runtime)
/tests

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Docker
*.dockerignore

# Node / Frontend (not needed in backend image)
node_modules
dist
public
src/
index.html
vite.config.ts
vitest.config.ts
tailwind.config.ts
tsconfig*.json
eslint.config.js
postcss.config.js
package.json
package-lock.json
components.json

# Reports / Docs (not needed at runtime)
*.docx
*.md
*.txt
ARCHITECTURE.md
PROJECT.md
PROJECT_SUMMARY.md
README.md
docs/

# Railway artifacts (not needed on Fly.io)
railway.toml
Procfile
backend/Dockerfile.fraud_worker
backend/Dockerfile.dlq_handler
backend/Dockerfile

# OpenCode
.opencode