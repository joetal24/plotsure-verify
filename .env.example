# ============================================
# PlotSure Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to version control.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- JWT ---
# Generate via: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-jwt-secret

# --- CORS / URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Neo4j ---
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# --- Kafka / Upstash ---
KAFKA_BOOTSTRAP_SERVERS=your-cluster.upstash.io:9092
KAFKA_TOPIC_FRAUD_CHECK=fraud.check.queue
KAFKA_TOPIC_DEAD_LETTER=fraud.check.failed
KAFKA_GROUP_ID=plotsure-fraud-workers

# --- Deployment ---
SYSTEM_ADMIN_EMAIL=admin@plotsure.ug